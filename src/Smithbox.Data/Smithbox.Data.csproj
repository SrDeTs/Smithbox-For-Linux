<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="imgui.ini">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="imgui.default">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Oodle texture decompression library for Nightreign (NR).
         Copied next to the smithbox executable so ProjectEntry.SetupDLLs can find it. -->
    <Content Include="liboo2corelinux64.so.9">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Linux native libraries are provided by the Hexa.NET.* NuGet packages (per-RID)
       and by the prebuilt binaries under src/native/linux-x64. The Windows-only .dll
       files (cimgui.dll, SDL2.dll, NavGen.dll, oo2core_*_win64.dll, etc.) are NOT
       shipped on Linux and are intentionally excluded here. -->

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DefineConstants>RELEASE</DefineConstants>
  </PropertyGroup>

</Project>
