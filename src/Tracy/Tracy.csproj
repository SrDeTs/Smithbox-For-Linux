<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>StudioCore</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- TracyClient native library is NOT shipped by default on Linux.
         To enable profiling, build TracyClient from source (cmake -DBUILD_SHARED_LIBS=ON
         -DTRACY_FIBERS=ON -DTRACY_MANUAL_LIFETIME=ON -DTRACY_DELAYED_INIT=ON) and place the
         resulting libTracyClient.so next to the Smithbox executable, then set SMITHBOX_PROFILER=1. -->
  </ItemGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DefineConstants>RELEASE</DefineConstants>
  </PropertyGroup>

</Project>
